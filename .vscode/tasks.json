{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: build",
            "command": "build",
            "targets": [
                "all"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "CMake template build task"
        },
        {
            "label": "Build docs (Doxygen)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/linux_preset",
                "--target",
                "doxygen"
            ],
            "problemMatcher": [],
            "detail": "Generate Doxygen HTML into build/linux_preset/docs/html"
        },
        {
            "label": "Run unit tests",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cmake --preset tests && cmake --build --preset tests && ctest --preset tests"
            ],
            "group": "test",
            "problemMatcher": [],
            "detail": "Configure, build and run the GTest unit tests"
        },
        {
            "label": "stop-gdbserver-remote",
            "type": "shell",
            "command": "ssh",
            "args": [
                "root@stm32mp1.local",
                "killall gdbserver || true"
            ],
        },
        {
            "label": "build-and-deploy",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "scp ${command:cmake.launchTargetPath} root@stm32mp1.local:/home/root/"
            ],
            "group": "build",
            "dependsOn": "stop-gdbserver-remote",
        },
        {
            "label": "start-gdbserver-remote",
            "type": "shell",
            "command": "ssh",
            "args": [
                "root@stm32mp1.local",
                "cd /home/root && gdbserver *:1234 ./dj"
            ],
            "dependsOn": "build-and-deploy",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "____"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Process.*created.*$",
                    "endsPattern": "^.*Listening on port.*$"
                }
            },
        }
    ]
}